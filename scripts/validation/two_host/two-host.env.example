# Two-host qualification settings: the CUDA worker and controller run on the Linux
# host, the MLX worker on a Mac reached over SSH. Copy this file into the run
# directory, fill in every value, and pass its path to each script:
#   scripts/validation/two_host/run.sh /path/to/run/two-host.env baseline
# Nothing here is committed with real values: keep host names, addresses and home
# paths in the copy inside the (ignored) run directory.

# ---------------------------------------------------------------- Linux (CUDA) host
RUN_DIR=/path/to/run                       # Evidence directory on the Linux host.
SOURCE_DIR=/path/to/run/source             # Clean hLLM clone the run uses (uv synced).
UV=/path/to/uv                             # uv executable (only build-cuda.sh uses it).
CUDA_BUILD_DIR=build/cuda                  # Relative to SOURCE_DIR.
CUDA_MODEL_ROOT=/path/to/model             # Checkpoint directory on the Linux host.
CUDA_ROOT=/usr/local/cuda
CUDA_ARCH=8.6                              # TORCH_CUDA_ARCH_LIST for the build.
# Colon-separated runtime libraries for the CUDA worker (gRPC prefix, NVIDIA wheels).
CUDA_LD_LIBRARY_PATH=/path/to/grpc-prefix/lib:/usr/local/cuda/lib64
# Optional conda prefix that provides gRPC, Protobuf and the host compiler. Leave
# CONDA_EXE empty to run commands directly.
CONDA_EXE=/path/to/conda
CONDA_PREFIX_DIR=/path/to/grpc-prefix
TORCH_PREFIX=/path/to/torch                # CMake prefix of a CUDA-enabled LibTorch.
CUDA_HOST_COMPILER=/path/to/grpc-prefix/bin/x86_64-conda-linux-gnu-g++
REFERENCE_PYTHON=/path/to/reference-env/bin/python   # Isolated oracle environment.
ORACLE_GPU_LAYERS=26                       # Layers the oracle keeps on the GPU (4B Base).
DROP_PAGE_CACHE=1                          # 1: `sudo -n` drop caches before each load.

# Admission caps (bytes) and worker limits. Raise a cap only with operator approval.
CUDA_HOST_LIMIT_BYTES=4026531840
CUDA_DEVICE_LIMIT_BYTES=6576668672
MLX_LIMIT_BYTES=5502926848
MAX_ACTIVE_REQUESTS=2
MAX_CACHED_TOKENS=768

# ------------------------------------------------------------------------- Mac host
MAC_SSH=mac                                # SSH alias (BatchMode must work).
MAC_REPO=/path/on/mac/to/hLLM              # Mac checkout at the same commit as SOURCE_DIR.
MAC_RUN_DIR=/path/on/mac/to/run            # Evidence directory on the Mac.
MLX_BUILD_DIR=build/native/mlx             # Relative to MAC_REPO.
MLX_MODEL_ROOT=build/models/model          # Relative to MAC_REPO, or absolute.
FOOTPRINT_HELPER=build/process-footprint   # Relative to MAC_REPO (process_footprint.c).

# ---------------------------------------------------------------------- experiment
MLX_PORT=50291                             # Linux reaches MLX through ssh -L on this port.
CUDA_PORT=50293                            # The Mac reaches CUDA through ssh -R on this port.
GUARD_SECONDS=2400
PROFILE_GUARD_SECONDS=1200
MANIFEST=inputs/manifest.json              # Relative to RUN_DIR (and MAC_RUN_DIR on the Mac).
PLAN=inputs/mlx-cuda.plan.json
REFERENCE=inputs/reference-f16.json
WORKLOAD=inputs/workload-128-256.json
BASELINE_CYCLES=3
BASELINE_REQUESTS=2
CYCLES=3
PAIRS=3
TIMEOUT=240
IDLE_SECONDS=10
PROFILE_CYCLES=3
# Free-text conditions recorded in profiles and evidence.
CONCURRENT_LOAD="describe other load on each host"
TRANSPORT="loopback on each host; Linux reaches MLX via ssh -L, the Mac reaches CUDA via ssh -R"
GUARD_DESCRIPTION="resource_guard.py on both hosts: 1 GiB available floor, 256 MiB/60 s swap-out, Mac pressure, 40-minute ceiling; Mac guard observes the worker with process_footprint"
